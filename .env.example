# ==============================================================================
# Telegram Bot Configuration
# ==============================================================================
# Obtain your bot token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# The target chat ID where daily reels are sent (Channel ID e.g. -100xxxxxxxxxx, Group ID, or User ID)
TELEGRAM_CHAT_ID=your_chat_id_or_channel_id_here

# ==============================================================================
# Video Generation Settings
# ==============================================================================
# Duration bounds in seconds (Reels constraint: 15s to 90s)
MIN_DURATION_SECONDS=15
MAX_DURATION_SECONDS=90

# Daily generation count (Scheduled automated runs)
DAILY_GENERATION_COUNT=10

# Video Resolution: 9:16 Vertical (1080x1920)
VIDEO_WIDTH=1080
VIDEO_HEIGHT=1920
VIDEO_FPS=30

# Reciter: Sheikh Yasir Ad-Dosary (EveryAyah: Yasser_Ad-Dussary_128kbps)
QURAN_RECITER_ID=Yasser_Ad-Dussary_128kbps

# Watermark or Channel Branding (optional, shown discreetly at the bottom)
CHANNEL_TAG=@QuranInTheSky

# ==============================================================================
# Video Sourcing APIs (Optional - System works out-of-the-box with CC0 catalog)
# ==============================================================================
# Free API key from https://www.pexels.com/api/
PEXELS_API_KEY=

# Free API key from https://pixabay.com/api/docs/
PIXABAY_API_KEY=

# ==============================================================================
# Server & Port Configuration (for Render Deployment)
# ==============================================================================
PORT=8080
HOST=0.0.0.0
